<Window x:Class="USBFormatter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Multi-Matter - Removable Drive Batch Formatter V1.0.1" Icon="Assets/MultiMatter.ico" Width="770" Height="700" MinWidth="670" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="#F5F5F5" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#2B2B2B" />
    <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#353535"/><Setter Property="BorderBrush" Value="#515151"/><Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#242424"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#666666"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Grid Margin="24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Multi-Matter" FontWeight="Bold" FontSize="27"/><TextBlock Text="Removable Drive Batch Formatter V1.0.1  •  Select USB drives or SD/microSD cards." Foreground="#AFAFAF" Margin="0,4,0,0"/></StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="DriveCount" Grid.Column="0" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Text="Removable drives"/>
      <Button x:Name="SelectAllButton" Grid.Column="1" Content="☐  Select All" Margin="0,0,8,0" Click="SelectAll_Click" ToolTip="Select or deselect all eligible removable drives"/>
      <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Click="Refresh_Click"/>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="#494949" BorderThickness="1" CornerRadius="12" Margin="0,10,0,0" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DriveList"/></ScrollViewer></Border>
    <Border Grid.Row="5" Background="{StaticResource Panel}" BorderBrush="#494949" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel>
      <TextBlock Text="Format settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"><TextBlock Text="File system" Foreground="#C8C8C8" Margin="0,0,0,6"/><ComboBox x:Name="FileSystemBox" SelectedIndex="0" Padding="7" Background="#343434" Foreground="#1E1E1E" BorderBrush="#5D5D5D"><ComboBoxItem Content="exFAT"/><ComboBoxItem Content="FAT32"/><ComboBoxItem Content="NTFS"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Volume label (same for every selected drive)" Foreground="#C8C8C8" Margin="0,0,0,6"/><TextBox x:Name="LabelBox" MaxLength="32"/></StackPanel>
      </Grid>
    </StackPanel></Border>
    <StackPanel Grid.Row="7"><DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="TestSoundButton" Content="Test Sound" Click="TestSound_Click" Padding="10,5" Margin="0,0,8,0"/><Button x:Name="AboutButton" Content="About / Credits" Click="About_Click" Padding="10,5"/></StackPanel><CheckBox x:Name="SoundToggle" Content="Play sound when batch finishes" IsChecked="True" Checked="SoundToggle_Changed" Unchecked="SoundToggle_Changed"/></DockPanel><TextBlock x:Name="StatusText" Foreground="#C5C5C5" TextWrapping="Wrap" Text="Ready." Margin="0,0,0,10"/><ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#FF8A24" Background="#3F3F3F"/></StackPanel>
    <Grid Grid.Row="9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Formatting permanently deletes files on selected volumes.  •  Multi-Matter V1.0.1" Foreground="#FFB49C" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="FormatButton" Grid.Column="1" Content="FORMAT SELECTED" FontWeight="Bold" Foreground="#161616" Background="#FF8A24" BorderBrush="#FF8A24" Padding="24,13" Click="Format_Click" Margin="12,0,0,0"/></Grid>
  </Grid>
</Window>
